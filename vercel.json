{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/apply.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/programs",
      "destination": "/index.html"
    },
    {
      "source": "/programs/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/business",
      "destination": "/index.html"
    },
    {
      "source": "/reviews",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    }
  ]
}
